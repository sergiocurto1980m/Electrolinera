# Copia este archivo a `.env.local` y rellena los valores.
# Solo se exponen al frontend las variables que empiezan por VITE_.
# NUNCA pongas aquí la secret key de Supabase.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# URL pública de la app para los enlaces de confirmación de Supabase.
# En desarrollo: http://localhost:8100
# En producción: la URL donde despliegues la web.
VITE_APP_URL=http://localhost:8100

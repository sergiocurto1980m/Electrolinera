{
  "name": "electrolinera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestión de puestos de carga para coches eléctricos",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:pages": "npm run build && node scripts/fetch-apk.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "cap:sync": "npm run build && cap sync android",
    "android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@ionic/vue": "^9.0.11",
    "@ionic/vue-router": "^9.0.11",
    "@supabase/supabase-js": "^2.119.0",
    "firebase": "^13.4.0",
    "ionicons": "^8.0.13",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
